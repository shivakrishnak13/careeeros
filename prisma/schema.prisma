// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}



enum JobStatus {
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum InterviewRound {
  HR_SCREENING
  TECHNICAL
  ASSIGNMENT
  MANAGERIAL
  FINAL
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}



model Job {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     String
  role        String
  jobUrl      String?
  description String?  @db.Text

  status      JobStatus @default(APPLIED)
  jobType     JobType?
  workMode    WorkMode?


  salaryMin   Int?
  salaryMax   Int?
  currency    String?  @default("INR")

  location    String?

  appliedAt   DateTime @default(now())
  deadlineAt  DateTime?

  notes       String?  @db.Text
  resumeUsed  String?

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews  Interview[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@map("jobs")
}



model Interview {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  round       InterviewRound
  status      InterviewStatus @default(SCHEDULED)
  scheduledAt DateTime?
  duration    Int?


  interviewer String?
  platform    String?
  meetingUrl  String?

  notes       String?  @db.Text
  feedback    String?  @db.Text
  result      String?

  jobId       String
  job         Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("interviews")
}
